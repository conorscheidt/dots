--- a/zathura/main.c
+++ b/zathura/main.c
@@ -165,6 +165,26 @@
                         gpointer data) {
   zathura_app_ctx_t* ctx = data;
   if (ctx->zathura == NULL || n_files < 1) {
+    return;
+  }
+
+  /* macOS: LaunchServices routes Finder/`open` requests to the already-running
+   * instance (application:openFiles: -> g_application_open). zathura holds one
+   * document per process and document_open() requires zathura->document == NULL,
+   * so hand every file this process cannot show to a fresh process. */
+  const bool busy = zathura_has_document(ctx->zathura);
+  for (gint i = busy ? 0 : 1; i < n_files; ++i) {
+    g_autofree char* extra = g_file_get_path(files[i]);
+    if (extra == NULL) {
+      continue;
+    }
+    char* spawn_argv[]      = {ctx->argv[0], extra, NULL};
+    g_autoptr(GError) error = NULL;
+    if (g_spawn_async(NULL, spawn_argv, NULL, G_SPAWN_SEARCH_PATH, NULL, NULL, NULL, &error) == FALSE) {
+      girara_error("Could not spawn zathura for '%s': %s", extra, error->message);
+    }
+  }
+  if (busy) {
     return;
   }
 
