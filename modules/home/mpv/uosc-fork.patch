+-- FORK: smooth macOS-trackpad scroll. Small pixel delta per tick (not a whole
+-- item), pure content scroll (no selection jump), longer glide. macOS fires
+-- many wheel events per swipe, so a fraction-of-item step reads as momentum.
+function Menu:handle_wheel_up()
+	self:scroll_by(round(self.item_height * -0.5), nil, {update_cursor = false, duration = 0.22})
+end
+function Menu:handle_wheel_down()
+	self:scroll_by(round(self.item_height * 0.5), nil, {update_cursor = false, duration = 0.22})
+end
 
