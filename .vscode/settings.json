{
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.formatterPath": "alejandra",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "alejandra"
        ]
      },
      "nixpkgs": {
        "expr": "let flake = builtins.getFlake \"${workspaceFolder}\"; in flake.inputs.nixpkgs.legacyPackages.${builtins.currentSystem}"
      },
      "options": {
        "darwin": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").darwinConfigurations.viator.options"
        },
        "home-manager": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").darwinConfigurations.viator.options.home-manager.users.type.getSubOptions []"
        },
        "nixvim": {
          "expr": "let flake = builtins.getFlake \"${workspaceFolder}\"; in (flake.inputs.nixvim.lib.evalNixvim { system = builtins.currentSystem; }).options"
        }
      }
    }
  }
}
